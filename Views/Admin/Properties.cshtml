@model Balay_Balay_Resort.ViewModels.AdminPropertiesViewModel
@using System.Linq
@{
    ViewData["Title"] = "Properties";
    Layout = "_AdminLayout";

    var minPrice  = ViewBag.MinPrice as decimal?;
    var maxPrice  = ViewBag.MaxPrice as decimal?;
    var guests    = ViewBag.Guests as int?;
    var bedrooms  = ViewBag.Bedrooms as int?;
    var bathrooms = ViewBag.Bathrooms as int?;
    var minRating = ViewBag.MinRating as double?;
    var amenitiesSelected = ViewBag.Amenities as List<string> ?? new List<string>();
    var sort      = ViewBag.Sort as string ?? "";

    bool hasAdvFilters = minPrice.HasValue || maxPrice.HasValue || guests.HasValue
                      || bedrooms.HasValue || bathrooms.HasValue || minRating.HasValue
                      || amenitiesSelected.Any() || !string.IsNullOrWhiteSpace(sort);

    var amenityList = new[] { "WiFi", "Parking", "Kitchen", "Beach Access", "Air Conditioning" };
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!--
================ ADMIN UNIT CREATION FLOW =================

ADMIN FLOW:
Admin → Properties → Add Property → Submit Unit

IMPORTANT REQUIREMENT:
- There MUST be a clearly visible button at the bottom of the Add Unit modal
- Label must be EXACT: "Submit Unit"

BEHAVIOR:
- This button submits the Add Property form
- It triggers POST: /admin/properties/add

VALIDATION FLOW:
1. User fills all required fields
2. User clicks "Submit Unit"
3. System validates inputs
4. If valid → submit form
5. If invalid → show validation errors, DO NOT submit

IMPORTANT RULES:
- Do NOT allow auto-submit
- Do NOT remove manual submit action
- Submission must be intentional by admin

UX INTENT:
This prevents accidental creation of property units
and ensures admin confirms all details before saving.

===========================================================
-->
<!-- Header -->
<div class="admin-props-header">
    <h1 class="admin-page-title" style="margin-bottom:0">Unit Management</h1>
    <button class="admin-add-btn" data-bs-toggle="modal" data-bs-target="#addPropertyModal">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
        </svg>
        Add Unit
    </button>
</div>

<!-- Search + Filter Bar -->
<form method="get" action="/admin/properties" class="admin-props-search-bar" id="adminFilterForm">
    <div class="admin-props-search-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor"
             viewBox="0 0 16 16" class="admin-props-search-icon">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.099zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z" />
        </svg>
        <input type="text" name="search" class="admin-props-search-input"
               placeholder="Search Units" value="@Model.SearchQuery" />
    </div>
    <button type="button" class="admin-props-filter-btn @(hasAdvFilters ? "active" : "")" onclick="toggleAdminFilterPanel()" title="Filters">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
            <path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5v-2z" />
        </svg>
    </button>

    <!-- Filter Panel (collapsible) -->
    <div class="admin-filter-panel" id="adminFilterPanel" style="@(hasAdvFilters ? "display:block;" : "display:none;")">
        <div class="filter-row">
            <div class="filter-field">
                <label>Min Price (₱)</label>
                <input type="number" name="minPrice" min="0" step="100"
                       placeholder="0"
                       value="@(minPrice?.ToString("0") ?? "")" />
            </div>
            <div class="filter-field">
                <label>Max Price (₱)</label>
                <input type="number" name="maxPrice" min="0" step="100"
                       placeholder="Any"
                       value="@(maxPrice?.ToString("0") ?? "")" />
            </div>
        </div>

        <div class="filter-row">
            <div class="filter-field">
                <label>Min Guests</label>
                <input type="number" name="guests" min="1" max="50"
                       placeholder="Any"
                       value="@(guests?.ToString() ?? "")" />
            </div>
            <div class="filter-field">
                <label>Min Bedrooms</label>
                <input type="number" name="bedrooms" min="1" max="20"
                       placeholder="Any"
                       value="@(bedrooms?.ToString() ?? "")" />
            </div>
        </div>

        <div class="filter-row">
            <div class="filter-field">
                <label>Min Bathrooms</label>
                <input type="number" name="bathrooms" min="1" max="20"
                       placeholder="Any"
                       value="@(bathrooms?.ToString() ?? "")" />
            </div>
            <div class="filter-field">
                <label>Min Rating</label>
                <select name="minRating">
                    <option value=""  selected="@(!minRating.HasValue)">Any</option>
                    <option value="3" selected="@(minRating == 3)">3 &amp; up</option>
                    <option value="4" selected="@(minRating == 4)">4 &amp; up</option>
                    <option value="5" selected="@(minRating == 5)">5</option>
                </select>
            </div>
        </div>

        <div class="filter-field" style="grid-column:1/-1;margin-bottom:14px;">
            <label>Amenities</label>
            <div class="filter-amenities">
                @foreach (var a in amenityList)
                {
                    var checkedAttr = amenitiesSelected.Contains(a) ? "checked" : "";
                    <label class="filter-amenity-chk">
                        <input type="checkbox" name="amenities" value="@a" @checkedAttr />
                        <span>@a</span>
                    </label>
                }
            </div>
        </div>

        <div class="filter-row">
            <div class="filter-field" style="grid-column:1/-1;">
                <label>Sort by</label>
                <select name="sort">
                    <option value=""           selected="@(sort == "")">Unit # (default)</option>
                    <option value="newest"     selected="@(sort == "newest")">Newest</option>
                    <option value="price_asc"  selected="@(sort == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(sort == "price_desc")">Price: High to Low</option>
                    <option value="rating"     selected="@(sort == "rating")">Top Rated</option>
                </select>
            </div>
        </div>

        <div class="filter-actions">
            <a href="/admin/properties" class="filter-clear-btn">Clear All</a>
            <button type="submit" class="filter-apply-btn">Apply Filters</button>
        </div>
    </div>
</form>

<!-- Property Grid -->
@if (!Model.Properties.Any())
{
    <div class="admin-placeholder-card">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="#cbd5e1" viewBox="0 0 16 16">
            <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146z" />
        </svg>
        <p>No units found.</p>
    </div>
}
else
{
    <div class="admin-props-grid">
        @foreach (var p in Model.Properties)
        {
            var firstImage = (p.PropertyImagePath ?? "").Split(',').FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))?.Trim() ?? "/images/bg-login.png";
            <div class="admin-prop-card @(!p.IsActive ? " admin-prop-card-inactive" : "")">
                <div class="admin-prop-img" style="position:relative;">
                    <img src="@firstImage" alt="@p.Property_Name" />
                    <span class="admin-prop-status-badge @(p.IsActive ? "badge-active" : "badge-inactive")">
                        @(p.IsActive ? "● Active" : "● Inactive")
                    </span>
                </div>
                <div class="admin-prop-body">
                    <div class="admin-prop-unit">Unit #@p.UnitNumber</div>
                    <div class="admin-prop-name">@p.Property_Name</div>
                    <div class="admin-prop-meta">
                        <span>
                            <img src="/images/icons/Beds.png" class="admin-meta-icon" alt="Beds" />
                            @p.BedNum Beds
                        </span>
                        <span>
                            <img src="/images/icons/Baths.png" class="admin-meta-icon" alt="Baths" />
                            @p.BathNum Baths
                        </span>
                        <span>
                            <img src="/images/icons/Guests.png" class="admin-meta-icon" alt="Guests" />
                            @p.GuestCapacity Guests
                        </span>
                    </div>
                    <div class="admin-prop-footer">
                        <div class="admin-prop-rating">
                            <span class="admin-star">★</span>
                            @{
                                var averageRating = p.Feedbacks != null && p.Feedbacks.Any()
                                    ? p.Feedbacks.Average(f => f.ReviewRate)
                                    : 0;

                                var reviewCount = p.Feedbacks?.Count ?? 0;
                                var amenities = p.Amenity_Properties != null
                                    ? string.Join(",", p.Amenity_Properties
                                        .Where(ap => ap.Amenity != null)
                                        .Select(ap => ap.Amenity!.Amenity_Name))
                                    : "";
                            }
                            <span>@averageRating.ToString("0.0") (@reviewCount)</span>
                        </div>
                        <div class="admin-prop-price">
                            &#8369;@p.Amount.ToString("N0")<span>/night</span>
                        </div>
                    </div>
                    <div class="admin-prop-actions">
                        <!-- Edit button triggers modal -->
                        <button class="admin-prop-edit-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#editPropertyModal"
                                data-id="@p.Property_ID"
                                data-unit="@p.UnitNumber"
                                data-name="@p.Property_Name"
                                data-beds="@p.BedNum"
                                data-baths="@p.BathNum"
                                data-guests="@p.GuestCapacity"
                                data-price="@p.Amount"
                                data-image="@p.PropertyImagePath"
                                data-description="@p.Description"
                                data-amenities="@amenities">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                            </svg>
                            Edit
                        </button>

                        <!-- Deactivate / Activate toggle -->
                        <button type="button"
                                class="@(p.IsActive ? "admin-prop-deactivate-btn" : "admin-prop-activate-btn")"
                                data-pid="@p.Property_ID"
                                data-pname="@Html.Encode(p.Property_Name)"
                                data-active="@p.IsActive.ToString().ToLower()"
                                onclick="openToggleFromBtn(this)">
                            @if (p.IsActive)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                                </svg>
                                <span>Deactivate</span>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                    <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                                </svg>
                                <span>Activate</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ===================== ADD UNIT MODAL ===================== -->
<div class="modal fade" id="addPropertyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable admin-unit-modal-dialog">
        <div class="modal-content admin-unit-modal-content">

            <div class="admin-unit-modal-top">
                <span class="admin-unit-modal-title">Add Unit</span>
                <button type="button" class="admin-unit-modal-close" data-bs-dismiss="modal">&times;</button>
            </div>

            <form method="post" action="/admin/properties/add" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="admin-unit-modal-body">

                    <!-- Basic Information -->
                    <p class="admin-unit-section-label">Basic Information</p>

                    <div class="admin-unit-field">
                        <label class="admin-unit-label">Unit Title</label>
                        <input name="Name" class="admin-unit-input" required />
                    </div>
                    <div class="admin-unit-field">
                        <label class="admin-unit-label">Unit #</label>
                        <input name="UnitNumber" class="admin-unit-input" required />
                    </div>
                    <div class="admin-unit-row">
                        <div class="admin-unit-field">
                            <label class="admin-unit-label">Price per Night (&#8369;)</label>
                            <input name="PricePerNight" type="number" min="1" class="admin-unit-input" required />
                        </div>
                        <div class="admin-unit-field">
                            <label class="admin-unit-label">Maximum Guests</label>
                            <input name="Guests" type="number" min="1" max="50" class="admin-unit-input" required />
                        </div>
                    </div>
                    <div class="admin-unit-row">
                        <div class="admin-unit-field">
                            <label class="admin-unit-label">Bedrooms</label>
                            <input name="Beds" type="number" min="1" max="20" class="admin-unit-input" required />
                        </div>
                        <div class="admin-unit-field">
                            <label class="admin-unit-label">Bathrooms</label>
                            <input name="Baths" type="number" min="1" max="20" class="admin-unit-input" required />
                        </div>
                    </div>
                    <div class="admin-unit-field">
                        <label class="admin-unit-label">Description</label>
                        <textarea name="Description" class="admin-unit-textarea" rows="4"></textarea>
                    </div>

                    <!-- Unit Images -->
                    <p class="admin-unit-section-label">Unit Images</p>
                    <div class="admin-unit-field">
                        <label class="admin-unit-label">Images <span style="color:#9ca3af;font-weight:400;">(select multiple)</span></label>
                        <label class="admin-upload-area" for="addImageInput" id="addUploadArea">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#9ca3af" viewBox="0 0 16 16">
                                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                                <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" />
                            </svg>
                            <span class="admin-upload-text">Click to upload images</span>
                            <span class="admin-upload-sub">You can select multiple files</span>
                        </label>
                        <input type="file" id="addImageInput" name="ImageFiles" multiple accept="image/*"
                               style="display:none" onchange="previewImages(this, 'addPreviewGrid')" />
                        <div class="admin-img-preview-grid" id="addPreviewGrid"></div>
                    </div>

                    <!-- Amenities -->
                    <p class="admin-unit-section-label">Amenities</p>
                    <div class="admin-amenity-row">
                        <input type="text" id="addAmenityInput" class="admin-unit-input" placeholder="e.g. WiFi" />
                        <button type="button" class="admin-amenity-add-btn" onclick="addAmenityTag('add')">+ Add</button>
                    </div>
                    <div class="admin-amenity-tags" id="addAmenityTags"></div>
                    <input type="hidden" name="Amenities" id="addAmenitiesHidden" />

                </div>

                <div class="admin-unit-modal-footer">
                    <button type="submit" class="admin-unit-submit-btn">Submit Unit</button>
                    <button type="button" class="admin-unit-cancel-btn" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===================== EDIT UNIT MODAL ===================== -->
<div class="modal fade" id="editPropertyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable admin-unit-modal-dialog">
        <div class="modal-content admin-unit-modal-content">

            <div class="admin-unit-modal-top">
                <span class="admin-unit-modal-title">Edit Unit</span>
                <button type="button" class="admin-unit-modal-close" data-bs-dismiss="modal">&times;</button>
            </div>

            <form method="post" action="/admin/properties/edit/0" id="editPropertyForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="admin-unit-modal-body">

                    <!-- Basic Information -->
                    <p class="admin-unit-section-label">Basic Information</p>

                    <div class="admin-unit-field">
                        <label class="admin-unit-label">Unit Title</label>
                        <input name="Name" id="editName" class="admin-unit-input" required />
                    </div>
                    <div class="admin-unit-field">
                        <label class="admin-unit-label">Unit #</label>
                        <input name="UnitNumber" id="editUnit" class="admin-unit-input" required />
                    </div>
                    <div class="admin-unit-row">
                        <div class="admin-unit-field">
                            <label class="admin-unit-label">Price per Night (&#8369;)</label>
                            <input name="PricePerNight" id="editPrice" type="number" min="1" class="admin-unit-input" required />
                        </div>
                        <div class="admin-unit-field">
                            <label class="admin-unit-label">Maximum Guests</label>
                            <input name="Guests" id="editGuests" type="number" min="1" max="50" class="admin-unit-input" required />
                        </div>
                    </div>
                    <div class="admin-unit-row">
                        <div class="admin-unit-field">
                            <label class="admin-unit-label">Bedrooms</label>
                            <input name="Beds" id="editBeds" type="number" min="1" max="20" class="admin-unit-input" required />
                        </div>
                        <div class="admin-unit-field">
                            <label class="admin-unit-label">Bathrooms</label>
                            <input name="Baths" id="editBaths" type="number" min="1" max="20" class="admin-unit-input" required />
                        </div>
                    </div>
                    <div class="admin-unit-field">
                        <label class="admin-unit-label">Description</label>
                        <textarea name="Description" id="editDescription" class="admin-unit-textarea" rows="4"></textarea>
                    </div>

                    <!-- Unit Images -->
                    <p class="admin-unit-section-label">Unit Images</p>
                    <div class="admin-unit-field">
                        <label class="admin-unit-label">Images <span style="color:#9ca3af;font-weight:400;">(select multiple to replace)</span></label>
                        <!-- Current images preview -->
                        <div class="admin-img-preview-grid" id="editCurrentGrid"></div>
                        <label class="admin-upload-area" for="editImageInput" style="margin-top:8px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#9ca3af" viewBox="0 0 16 16">
                                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                                <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" />
                            </svg>
                            <span class="admin-upload-text">Click to upload new images</span>
                            <span class="admin-upload-sub">Selecting new images will replace existing ones</span>
                        </label>
                        <input type="file" id="editImageInput" name="ImageFiles" multiple accept="image/*"
                               style="display:none" onchange="previewImages(this, 'editNewGrid')" />
                        <div class="admin-img-preview-grid" id="editNewGrid"></div>
                    </div>

                    <!-- Amenities -->
                    <p class="admin-unit-section-label">Amenities</p>
                    <div class="admin-amenity-row">
                        <input type="text" id="editAmenityInput" class="admin-unit-input" placeholder="e.g. WiFi" />
                        <button type="button" class="admin-amenity-add-btn" onclick="addAmenityTag('edit')">+ Add</button>
                    </div>
                    <div class="admin-amenity-tags" id="editAmenityTags"></div>
                    <input type="hidden" name="Amenities" id="editAmenitiesHidden" />

                </div>

                <div class="admin-unit-modal-footer">
                    <button type="submit" class="admin-unit-submit-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v4.5h2a.5.5 0 0 1 .354.854l-2.5 2.5a.5.5 0 0 1-.708 0l-2.5-2.5A.5.5 0 0 1 5.5 6.5h2V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z" />
                        </svg>
                        Save Changes
                    </button>
                    <button type="button" class="admin-unit-cancel-btn" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===================== TOGGLE STATUS MODAL ===================== -->
<div class="modal fade" id="toggleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered admin-delete-dialog">
        <div class="modal-content admin-delete-content">
            <div class="admin-delete-icon-wrap">
                <div class="admin-delete-icon" id="toggleModalIcon"
                     style="background:#fee2e2;color:#dc2626;">
                    <svg id="toggleModalSvg" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                    </svg>
                </div>
            </div>
            <h5 class="admin-delete-title" id="toggleModalTitle">Deactivate Unit</h5>
            <p class="admin-delete-msg">
                <span id="toggleModalMsg"></span><br />
                <strong id="toggleModalName"></strong>?<br />
                <span class="admin-delete-warning" id="toggleModalWarning">The unit will be hidden from guests and no new bookings can be made. Existing bookings remain intact.</span>
            </p>
            <div class="admin-delete-actions">
                <button type="button" class="admin-delete-cancel-btn" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="admin-delete-confirm-btn" id="toggleModalBtn" onclick="confirmToggle()">Confirm</button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden toggle form -->
<form method="post" id="toggleForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function toggleAdminFilterPanel() {
            const panel = document.getElementById('adminFilterPanel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        }

        function openToggleFromBtn(btn) {
            openToggleModal(btn.dataset.pid, btn.dataset.pname, btn.dataset.active);
        }

        function openToggleModal(id, name, isActive) {
            const deactivating = isActive === true || isActive === 'true';
            document.getElementById('toggleModalName').textContent = name;
            document.getElementById('toggleForm').action = '/admin/properties/toggle/' + id;

            const icon   = document.getElementById('toggleModalIcon');
            const title  = document.getElementById('toggleModalTitle');
            const msg    = document.getElementById('toggleModalMsg');
            const warn   = document.getElementById('toggleModalWarning');
            const btn    = document.getElementById('toggleModalBtn');

            if (deactivating) {
                icon.style.background = '#fee2e2';
                icon.style.color      = '#dc2626';
                title.textContent     = 'Deactivate Unit';
                msg.textContent       = 'Are you sure you want to deactivate';
                warn.textContent      = 'The unit will be hidden from guests. Existing bookings remain intact.';
                btn.style.background  = '#dc2626';
                btn.textContent       = '🔴 Yes, Deactivate';
            } else {
                icon.style.background = '#dcfce7';
                icon.style.color      = '#16a34a';
                title.textContent     = 'Activate Unit';
                msg.textContent       = 'Are you sure you want to activate';
                warn.textContent      = 'The unit will be visible to guests and available for booking.';
                btn.style.background  = '#16a34a';
                btn.textContent       = '🟢 Yes, Activate';
            }

            new bootstrap.Modal(document.getElementById('toggleModal')).show();
        }

        function confirmToggle() {
            document.getElementById('toggleForm').submit();
        }

        // Pre-fill Edit modal
        document.getElementById('editPropertyModal').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('editId').value          = btn.dataset.id;
            document.getElementById('editUnit').value        = btn.dataset.unit;
            document.getElementById('editName').value        = btn.dataset.name;
            document.getElementById('editBeds').value        = btn.dataset.beds;
            document.getElementById('editBaths').value       = btn.dataset.baths;
            document.getElementById('editGuests').value      = btn.dataset.guests;
            document.getElementById('editPrice').value       = btn.dataset.price;
            document.getElementById('editDescription').value = btn.dataset.description || '';
            document.getElementById('editPropertyForm').action = '/admin/properties/edit/' + btn.dataset.id;

            // Restore amenity tags
            const editTags = document.getElementById('editAmenityTags');
            editTags.innerHTML = '';
            document.getElementById('editAmenitiesHidden').value = '';
            const saved = btn.dataset.amenities || '';
            if (saved) saved.split(',').filter(Boolean).forEach(a => createTag('edit', a.trim()));

            // Show existing images as thumbnails
            const imagePaths = (btn.dataset.image || '').split(',').filter(x => x.trim());
            const currentGrid = document.getElementById('editCurrentGrid');
            currentGrid.innerHTML = '';
            document.getElementById('editNewGrid').innerHTML = '';
            document.getElementById('editImageInput').value = '';
            imagePaths.forEach(path => {
                const wrap = document.createElement('div');
                wrap.className = 'admin-preview-thumb';
                const img = document.createElement('img');
                img.src = path.trim();
                wrap.appendChild(img);
                currentGrid.appendChild(wrap);
            });
        });

        // Clear Add modal when opened
        document.getElementById('addPropertyModal').addEventListener('show.bs.modal', function () {
            document.getElementById('addAmenityTags').innerHTML = '';
            document.getElementById('addAmenitiesHidden').value = '';
            document.getElementById('addPreviewGrid').innerHTML = '';
            document.getElementById('addImageInput').value = '';
        });

        // Add amenity tag
        function addAmenityTag(prefix) {
            const input = document.getElementById(prefix + 'AmenityInput');
            const val = input.value.trim();
            if (!val) return;
            createTag(prefix, val);
            input.value = '';
        }

        function createTag(prefix, text) {
            const container = document.getElementById(prefix + 'AmenityTags');
            const tag = document.createElement('span');
            tag.className = 'admin-amenity-tag';
            tag.innerHTML = text + ' <button type="button" onclick="removeTag(this, \'' + prefix + '\')">×</button>';
            container.appendChild(tag);
            updateHidden(prefix);
        }

        function removeTag(btn, prefix) {
            btn.parentElement.remove();
            updateHidden(prefix);
        }

        function updateHidden(prefix) {
            const tags = document.querySelectorAll('#' + prefix + 'AmenityTags .admin-amenity-tag');
            document.getElementById(prefix + 'AmenitiesHidden').value =
                Array.from(tags).map(t => t.textContent.replace('×','').trim()).join(',');
        }

        // Show image thumbnails in a preview grid
        function previewImages(input, gridId) {
            const grid = document.getElementById(gridId);
            grid.innerHTML = '';
            const files = Array.from(input.files);
            if (!files.length) return;

            files.forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const wrap = document.createElement('div');
                    wrap.className = 'admin-preview-thumb';
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    wrap.appendChild(img);
                    grid.appendChild(wrap);
                };
                reader.readAsDataURL(file);
            });
        }

        // Show existing images in edit modal
        document.getElementById('editPropertyModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            const imagePaths = (btn.dataset.image || '').split(',').filter(x => x.trim());
            const grid = document.getElementById('editCurrentGrid');
            grid.innerHTML = '';
            document.getElementById('editNewGrid').innerHTML = '';

            if (imagePaths.length) {
                imagePaths.forEach(path => {
                    const wrap = document.createElement('div');
                    wrap.className = 'admin-preview-thumb';
                    const img = document.createElement('img');
                    img.src = path.trim();
                    wrap.appendChild(img);
                    grid.appendChild(wrap);
                });
            }
        });
    </script>
}